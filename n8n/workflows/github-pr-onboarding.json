{
  "name": "GitHub PR Onboarding Comment",
  "nodes": [
    {
      "parameters": {
        "owner": "={{ $vars.owner }}",
        "repository": "={{ $vars.repository }}",
        "events": [
          "pull_request"
        ],
        "additionalFields": {
          "actions": [
            "opened"
          ]
        }
      },
      "id": "github-trigger",
      "name": "GitHub Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ],
      "credentials": {
        "githubApi": {
          "id": "replace-with-your-credential-id",
          "name": "GitHub API"
        }
      }
    },
    {
      "parameters": {
        "resource": "issueComment",
        "operation": "create",
        "owner": "={{ $vars.owner }}",
        "repository": "={{ $vars.repository }}",
        "issueNumber": "={{ $json.number }}",
        "body": "Hi @{{ $json.pull_request.user.login }} 👋\\n\\nThanks for opening this PR. Please add:\\n- a quick summary of what changed\\n- test evidence (logs/screenshots)\\n- linked issue number(s)\\n\\nThis comment was added automatically by n8n."
      },
      "id": "github-comment",
      "name": "Post PR onboarding comment",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        560,
        300
      ],
      "credentials": {
        "githubApi": {
          "id": "replace-with-your-credential-id",
          "name": "GitHub API"
        }
      }
    }
  ],
  "connections": {
    "GitHub Trigger": {
      "main": [
        [
          {
            "node": "Post PR onboarding comment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
